# Export in the environment that launches Codex; this file is not auto-loaded.
TYPESAFE_API_KEY=
# Explicit opt-in: sends transcript text, tool inputs and output previews to TypeSafe.
JEV_ENABLE=0

# Optional alternative: absolute path to a chmod 600 file containing only the key.
# TYPESAFE_API_KEY_FILE=/absolute/private/path/jev-key
